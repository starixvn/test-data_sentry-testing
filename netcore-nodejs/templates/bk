  webapp_v1:
    container_name: "{{site_name}}_v1"
    image: regdocker.nexdev.net/dev/{{site_name | lower}}:{{dotnet_version}}
    build:
      context: .
      dockerfile: Dockerfile
    networks:
      - frontend_nic
    volumes:
{%if volume_name is defined%} 
