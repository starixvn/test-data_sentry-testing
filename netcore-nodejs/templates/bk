  nginx:
    container_name: "nginx_{{site_name}}"
    image: regdocker.nexdev.net/dev/nginx:{{nginx_version | default('1.19.1')}}
    build:
      context: .
      dockerfile: conf/Dockerfile
    restart: {{restart_mode | default('always')}}
    ports:
{%if port80 is defined and port80=='no' %}
      - "{{site_port}}:{{site_port}}"
{%else %}
      - "{{site_port}}:80"
{%endif%}
{% if site_port1 is defined %}
      - "{{site_port1}}:{{site_port1}}"
{% endif %}
{% if site_port2 is defined %}
      - "{{site_port2}}:{{site_port2}}"
{% endif %}
    volumes:
      - ./conf/nginx.conf:/etc/nginx/conf.d/default.conf
      - ./logs:/var/log/nginx/
    networks:
      - backend_nic
      - frontend_nic
networks:
  backend_nic:
    external:
      name: backend_nic
  frontend_nic:
    external:
      name: frontend_nic

{%if volume_name is defined%} 
volumes:
  {{ volume_name }}:
    external: true
{%endif%}