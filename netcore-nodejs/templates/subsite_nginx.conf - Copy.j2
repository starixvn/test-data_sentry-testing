upstream webapi {
    server webapp:{{proxy_port| default('80')}};
}
upstream webapi_v1 {
    server webapp_v1:{{proxy_port| default('80')}};
}
upstream webapi_v2 {
    server webapp_v2:{{proxy_port| default('80')}};
}
server {
    listen {{site_port}};
    access_log  /var/log/nginx/{{ site_name }}.access.log;
	error_log  /var/log/nginx/{{ site_name }}.error.log;
	location / {
	proxy_pass http://webapi/;
    proxy_http_version 1.1;
	proxy_set_header   Upgrade $http_upgrade;
	proxy_set_header   Connection {{ Site_Connection | default('keep-alive')}};
	proxy_set_header   Host $host;
	proxy_set_header X-Forwarded-Host $host:$server_port;
	proxy_cache_bypass $http_upgrade;
	proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header   X-Forwarded-Proto $scheme;
		}
		location /whoami {
	      default_type text/plain;
	      return 200 "SITE: {{site_name}}\nSERVER IP: Physical IP - {{ ansible_default_ipv4.address }} | Container IP - $server_addr\nSERVER FWD IP: $proxy_add_x_forwarded_for\nPUBLIC PORT: {{site_port}}\nProxy PORT: {{proxy_port|default('80')}}\nProject Path: {%if volume_name is defined%} /var/lib/docker/volumes/{{site_name}}/_data {%else %} {{working_directory}}/app {%endif%}";
		}
	}
