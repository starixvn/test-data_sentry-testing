version: "3.3"
services:
  app_{{site_name}}:
    container_name: "{{site_name}}"
{% if dotnet_version is defined %}
    image: regdocker.nexdev.net/dev/netcore-{{img_name | lower}}:{{dotnet_version}}
{%endif%}
{% if nodejs_version is defined %}
    image: regdocker.nexdev.net/dev/nodejs-{{img_name | lower}}:{{nodejs_version}}
{%endif%}
    build:
      context: .
      dockerfile: Dockerfile
    restart: {{restart_mode | default('always')}}
    networks:
      - backend_nic
    volumes:
{%if volume_name is defined%} 
      - {{volume_name}}:/app
{%else %}
      - {{web_path | default('./app')}}:/app
{%endif%}
  nginx_{{site_name}}:
    container_name: "{{site_name}}_nginx"
    image: regdocker.nexdev.net/dev/nginx:{{nginx_version | default('1.19.1')}}
    build:
      context: .
      dockerfile: conf/Dockerfile
    restart: {{restart_mode | default('always')}}
    ports:
{%if port80 is defined and port80=='no' %}
      - "{{site_port}}:{{site_port}}"
{%else %}
      - "{{site_port}}:80"
{%endif%}
    volumes:
      - ./conf/nginx.conf:/etc/nginx/conf.d/default.conf
      - ./logs:/var/log/nginx/
{%if whitelist is defined and whitelist=='yes'%}
      - ./conf/whitelist.conf:/etc/nginx/whitelist.conf
{%endif%}
    networks:
      - backend_nic
      - frontend_nic

networks:
  backend_nic:
    external:
      name: backend_nic
  frontend_nic:
    external:
      name: frontend_nic

{%if volume_name is defined%} 
volumes:
  {{ volume_name }}:
    external: true
{%endif%}