#######################################################################
server {
    listen 80;
    listen {{site_port}};
    real_ip_header X-Forwarded-For;
{%if whitelist is defined and whitelist=='yes'%}
    include /etc/nginx/whitelist.conf;
{%endif%}
{%if env is defined and env=='local' %}
    set_real_ip_from 10.18.200.124;
    set_real_ip_from 10.18.200.125;
{%endif%}
{%if env is defined and env=='kbt' %}
    set_real_ip_from 10.3.254.81;
{%endif%}
    access_log  /var/log/nginx/{{ site_name }}.access.log;
    error_log  /var/log/nginx/{{ site_name }}.error.log;
	# issue with ip and the nginx proxy
    location / {
        proxy_pass http://app_{{site_name}}:{{proxy_port| default('80')}};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection keep-alive;
        proxy_set_header   Host $host:$server_port;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        client_max_body_size    50m;
        client_body_buffer_size 128k;
    }
    location /whoami {
        default_type text/plain;
	    return 200 "SITE: {{site_name}}\nSERVER IP: Physical IP - {{ ansible_default_ipv4.address }} | Container IP - $server_addr\nSERVER FWD IP: $proxy_add_x_forwarded_for\nPUBLIC PORT: {{site_port}}\nProxy PORT: {{proxy_port|default('80')}}\nProject Path: {%if volume_name is defined%} /var/lib/docker/volumes/{{site_name}}/_data {%else %} {{working_directory}}/app {%endif%}";
	}
}