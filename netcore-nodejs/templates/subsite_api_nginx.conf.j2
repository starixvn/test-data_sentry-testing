	{%endif%}
    location /whoami {
	      default_type text/plain;
	      return 200 "SITE: {{site_name}} \nSERVER IP: Physical IP - {{ ansible_default_ipv4.address }} | Container IP - $server_addr \nSERVER FWD IP: $proxy_add_x_forwarded_for \nPUBLIC PORT: {{site_port}}\nProxy PORT: {{proxy_port|default('80')}}\nProject Path: {%if volume_name is defined%} /var/lib/docker/volumes/{{site_name}}/_data {%else %} {{working_directory}}/v1/app, {{working_directory}}/v2/app, {{working_directory}}/v3/app {%endif%}";
