upstream webapi_v1 {
    server webapp_v1:{{proxy_port| default('80')}};
}
upstream webapi_v2 {
    server webapp_v2:{{proxy_port| default('80')}};
}
upstream webapi_v3 {
    server webapp_v3:{{proxy_port| default('80')}};
}
{%if total_site is defined and total_site >3 %}
upstream webapi_v4 {
    server webapp_v4:{{proxy_port| default('80')}};
}
upstream webapi_v5 {
