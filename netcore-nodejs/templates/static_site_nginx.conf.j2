server {
    listen 80;
    listen {{site_port}};
{%if whitelist is defined and whitelist=='yes'%}
    include /etc/nginx/whitelist.conf;
{%endif%}
    real_ip_header X-Forwarded-For;
{%if env is defined and env=='local' %}
    set_real_ip_from 10.18.200.124;
    set_real_ip_from 10.18.200.125;
{%endif%}
{%if env is defined and env=='kbt' %}
    set_real_ip_from 10.3.254.81;
{%endif%}
    access_log  /var/log/nginx/{{ site_name }}.access.log;
    error_log  /var/log/nginx/{{ site_name }}.error.log;
    root /usr/share/nginx;
    index index.html;
	# issue with ip and the nginx proxy
    location / {
        try_files $uri $uri/ =404;
    }
    location ~* \.(?:jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|css|js)$ {
            expires {{ expire_time | default('1M')}};
            access_log off;
            add_header Cache-Control "public";
        }
    location /whoami {
        default_type text/plain;
        {%if web_path is defined%}
	    return 200 "SITE: {{site_name}}\nSERVER IP: Physical IP - {{ ansible_default_ipv4.address }} | Container IP - $server_addr\nSERVER FWD IP: $proxy_add_x_forwarded_for\nPUBLIC PORT: {{site_port}}\nProxy PORT: {{proxy_port|default('80')}}\nProject Path: {{web_path}}";
	    {%else%}
	    return 200 "SITE: {{site_name}}\nSERVER IP: Physical IP - {{ ansible_default_ipv4.address }} | Container IP - $server_addr\nSERVER FWD IP: $proxy_add_x_forwarded_for\nPUBLIC PORT: {{site_port}}\nProxy PORT: {{proxy_port|default('80')}}\nProject Path: {{working_directory}}/app";
	    {%endif%}
	}

}