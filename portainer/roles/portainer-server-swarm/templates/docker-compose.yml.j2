version: '3.5'

services:
  agent:
    image: portainer/agent
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    networks:
      - {{swarm_network_nexops}}
    environment:
      AGENT_SECRET: {{portainer_agent_secret}}
    deploy:
      mode: global
      placement:
        constraints: [node.platform.os == linux]

  portainer:
    image: portainer/portainer-ce
    command: -H tcp://tasks.agent:9001 --tlsskipverify
    ports:
      - 9000:9000
    volumes:
      - {{portainer_volume_name}}:/data
    networks:
      - {{swarm_network_nexops}}
    environment:
      AGENT_SECRET: {{portainer_agent_secret}}
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.NEXOPS_LOW_STORAGE == yes

networks:
  {{swarm_network_nexops}}:
     external: true

volumes:
  {{portainer_volume_name}}:
    driver_opts:
      o: bind
      type: none
      device: {{gluster_path}}/portainer